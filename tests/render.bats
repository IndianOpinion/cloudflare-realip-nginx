#!/usr/bin/env bats
# 4.4 render cases and V9 ordering.

load helpers/common

setup() { common_setup; }

@test "R1: default output matches the golden file" {
	run --separate-stderr cfrn --dry-run
	[ "$status" -eq 0 ]
	[ "$output" = "$(cat "$GOLDEN/default.conf")" ]
	[ "$(head -n 1 "$GOLDEN/default.conf")" = "# Generated by cloudflare-realip-nginx. Do not edit: changes are overwritten." ]
}

@test "R2: X-Forwarded-For golden file" {
	run --separate-stderr cfrn --dry-run --header X-Forwarded-For --recursive
	[ "$status" -eq 0 ]
	[ "$output" = "$(cat "$GOLDEN/xff-recursive.conf")" ]
}

@test "R3: the recursive line is present, with a warning for CF-Connecting-IP" {
	run cfrn --dry-run --recursive
	[ "$status" -eq 0 ]
	[[ $output == *"real_ip_recursive on;"* ]]
	[[ $output == *"warning: real_ip_recursive has no effect with CF-Connecting-IP"* ]]
	run cfrn --dry-run --recursive --header X-Forwarded-For
	[[ $output != *"has no effect"* ]]
}

@test "R5: two renders are byte-identical and carry no timestamp" {
	run --separate-stderr cfrn --dry-run
	first=$output
	sleep 1
	run --separate-stderr cfrn --dry-run
	[ "$output" = "$first" ]
	! grep -Eq '20[0-9]{2}-[0-9]{2}-[0-9]{2}|[0-9]{2}:[0-9]{2}:[0-9]{2}' <<<"$output"
}

@test "V9: shuffled input renders identical output" {
	serve_v4 v4-shuffled.txt
	run --separate-stderr cfrn --dry-run
	[ "$status" -eq 0 ]
	[ "$output" = "$(cat "$GOLDEN/default.conf")" ]
}

@test "V9: IPv4 sorts numerically, not as text" {
	run --separate-stderr cfrn --dry-run
	v4=$(grep -o 'set_real_ip_from [0-9.]*/[0-9]*' <<<"$output" | head -n 2 | tail -n 1)
	[ "$v4" = "set_real_ip_from 103.22.200.0/22" ]
}
