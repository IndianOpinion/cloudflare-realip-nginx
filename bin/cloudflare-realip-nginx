#!/usr/bin/env bash
#
# cloudflare-realip-nginx: rebuild the nginx real-IP snippet from
# Cloudflare's published IPv4 and IPv6 ranges, test it, install it
# atomically and reload nginx only when the content changed.
#
# Copyright (c) 2026 Indian Opinion. MIT licence, see LICENSE.
# Design notes: docs/ARCHITECTURE.md in the source repository.

set -euo pipefail
umask 022

readonly VERSION="0.1.0"
readonly PROG="cloudflare-realip-nginx"
# The first line of every snippet this tool writes. It is the contract the
# foreign-file check (W11) relies on; do not change it within 0.x.
readonly MARKER="# Generated by cloudflare-realip-nginx. Do not edit: changes are overwritten."
readonly DEFAULT_CONFIG="/etc/default/cloudflare-realip-nginx"
readonly PINNED_HOST="www.cloudflare.com"
readonly MAX_REDIRECTS=3

readonly EX_OK=0
readonly EX_CONFIG=1
readonly EX_FETCH=2
readonly EX_INVALID=3
readonly EX_TEST=4
readonly EX_RELOAD=5
readonly EX_LOCKED=6
readonly EX_DIFF=10

# ---------------------------------------------------------------------------
# Settings. Defaults first; the config file, then the environment, then the
# command line override them in that order.
# ---------------------------------------------------------------------------

readonly -a CFG_KEYS=(
	CFRN_OUTPUT CFRN_STATE_DIR CFRN_STAGING_DIR CFRN_URL_V4 CFRN_URL_V6
	CFRN_PIN_HOST CFRN_HEADER CFRN_RECURSIVE CFRN_EXTRA_TRUSTED
	CFRN_MIN_COUNT_V4 CFRN_MIN_COUNT_V6 CFRN_MAX_COUNT CFRN_MIN_PREFIX_V4
	CFRN_MIN_PREFIX_V6 CFRN_MAX_SHRINK_PERCENT CFRN_CONNECT_TIMEOUT
	CFRN_TOTAL_TIMEOUT CFRN_ATTEMPTS CFRN_RETRY_DELAY CFRN_MAX_BODY_BYTES
	CFRN_NGINX CFRN_TEST_COMMAND CFRN_DUMP_COMMAND CFRN_RELOAD_COMMAND CFRN_SERVICE_NAME
	CFRN_SERVICE_MANAGER CFRN_PID_FILE CFRN_PRIV_HELPER CFRN_STALE_DAYS
	CFRN_HOLD_DAYS CFRN_SYSLOG CFRN_SYSLOG_TAG CFRN_METRICS_DIR
)

declare -A CFG=(
	[CFRN_OUTPUT]=/etc/nginx/conf.d/cloudflare-realip.conf
	[CFRN_STATE_DIR]=/var/lib/cloudflare-realip-nginx
	[CFRN_STAGING_DIR]=
	[CFRN_URL_V4]=https://www.cloudflare.com/ips-v4
	[CFRN_URL_V6]=https://www.cloudflare.com/ips-v6
	[CFRN_PIN_HOST]=yes
	[CFRN_HEADER]=CF-Connecting-IP
	[CFRN_RECURSIVE]=no
	[CFRN_EXTRA_TRUSTED]=
	[CFRN_MIN_COUNT_V4]=10
	[CFRN_MIN_COUNT_V6]=3
	[CFRN_MAX_COUNT]=200
	[CFRN_MIN_PREFIX_V4]=8
	[CFRN_MIN_PREFIX_V6]=16
	[CFRN_MAX_SHRINK_PERCENT]=50
	[CFRN_CONNECT_TIMEOUT]=10
	[CFRN_TOTAL_TIMEOUT]=30
	[CFRN_ATTEMPTS]=3
	[CFRN_RETRY_DELAY]=2
	[CFRN_MAX_BODY_BYTES]=65536
	[CFRN_NGINX]=nginx
	[CFRN_TEST_COMMAND]=
	[CFRN_DUMP_COMMAND]=
	[CFRN_RELOAD_COMMAND]=
	[CFRN_SERVICE_NAME]=nginx
	[CFRN_SERVICE_MANAGER]=auto
	[CFRN_PID_FILE]=/run/nginx.pid
	[CFRN_PRIV_HELPER]=auto
	[CFRN_STALE_DAYS]=14
	[CFRN_HOLD_DAYS]=7
	[CFRN_SYSLOG]=yes
	[CFRN_SYSLOG_TAG]=cloudflare-realip-nginx
	[CFRN_METRICS_DIR]=
)

# Values captured from the environment before anything else runs.
declare -A ENV_VAL=()
for _key in "${CFG_KEYS[@]}"; do
	if [[ -n ${!_key+x} ]]; then
		ENV_VAL[$_key]=${!_key}
	fi
done
unset _key

# Runtime state.
MODE=update
CONFIG_FILE=
CONFIG_EXPLICIT=0
FORCE=0
WITH_TEST=0
QUIET=0
SYSLOG_ON=1
SYSLOG_TAG=$PROG
INFO_TO_STDERR=0
declare -A FLAG_VAL=()
declare -a FLAG_EXTRA=()

OUTPUT= OUTPUT_DIR= STATE_DIR= STAGING_DIR= URL_V4= URL_V6= HEADER=
declare -a EXTRAS=() TEST_CMD=() DUMP_CMD=() RELOAD_CMD=() HELPER=()
NGINX_BIN= SERVICE_MANAGER= IS_ROOT=0
NOW=0

WORKDIR=
declare -a CLEANUP_FILES=()
LOCK_HELD=0
RECORD_RUN=0
RUN_RESULT=failed
RUN_SUCCESS=0

declare -A STATE=()
readonly -a STATE_KEYS=(
	last_run last_exit last_result last_success count_v4 count_v6
	snippet_sha256 pending_reload in_progress in_progress_had_backup
	hold_until
)

declare -a LIST_V4=() LIST_V6=()
declare -a PREV_V4=() PREV_V6=() PREV_ALL=()
declare -a ADDED=() REMOVED=()

# ---------------------------------------------------------------------------
# Logging: stdout for information, stderr for warnings and errors, and one
# syslog line per message at the matching priority.
# ---------------------------------------------------------------------------

_syslog() {
	[[ $SYSLOG_ON == 1 ]] || return 0
	logger -t "$SYSLOG_TAG" -p "daemon.$1" -- "$2" >/dev/null 2>&1 || true
}

info() {
	if [[ $QUIET == 0 ]]; then
		if [[ $INFO_TO_STDERR == 1 ]]; then
			printf '%s\n' "$*" >&2
		else
			printf '%s\n' "$*"
		fi
	fi
	_syslog info "$*"
}

notice() {
	if [[ $QUIET == 0 ]]; then
		if [[ $INFO_TO_STDERR == 1 ]]; then
			printf '%s\n' "$*" >&2
		else
			printf '%s\n' "$*"
		fi
	fi
	_syslog notice "$*"
}

warn() {
	printf 'warning: %s\n' "$*" >&2
	_syslog warning "$*"
}

err() {
	printf 'error: %s\n' "$*" >&2
	_syslog err "$*"
}

die() {
	local code=$1
	shift
	err "$*"
	exit "$code"
}

# Quote at most one line of untrusted text: printable ASCII only, cut short.
quote_line() {
	local s=$1
	s=${s//[^[:print:]]/?}
	if ((${#s} > 200)); then
		s="${s:0:200}..."
	fi
	printf '%s' "$s"
}

# ---------------------------------------------------------------------------
# Cleanup and signals
# ---------------------------------------------------------------------------

cleanup() {
	local f
	for f in "${CLEANUP_FILES[@]+"${CLEANUP_FILES[@]}"}"; do
		if [[ -n $f && -e $f ]]; then
			rm -f -- "$f" || true
		fi
	done
	if [[ -n $WORKDIR && -d $WORKDIR ]]; then
		rm -rf -- "$WORKDIR" || true
	fi
}

on_exit() {
	local rc=$?
	trap - EXIT
	if [[ $RECORD_RUN == 1 && $LOCK_HELD == 1 ]]; then
		record_run "$rc" || true
	fi
	cleanup
	exit "$rc"
}

on_signal() {
	err "interrupted by SIG$1"
	exit "$2"
}

trap on_exit EXIT
trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM
trap 'on_signal HUP 129' HUP

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
	cat <<USAGE
Usage: $PROG [mode] [options]

Rebuild the nginx real-IP snippet from Cloudflare's published IP ranges.

Modes (one at a time; the default is to update):
  --dry-run            Fetch, validate and print the snippet; change nothing.
  --diff               Print a unified diff against the live snippet.
                       Exit 0 when equal, 10 when different.
  --rollback           Swap the live snippet with the backup, test, reload,
                       and hold scheduled runs until --release.
  --release            Clear the hold set by --rollback.
  --verify             Check that the setup works; exit 0 only if all pass.
  --status             Print the last run, last success and counts.
  --version            Print the version.
  --help               Print this help.

Options:
  --config FILE        Config file (default $DEFAULT_CONFIG).
  --output FILE        Snippet path (absolute, not a symlink).
  --header NAME        Header carrying the visitor address
                       (default CF-Connecting-IP).
  --recursive          Add "real_ip_recursive on".
  --extra-trusted CIDR Also trust this range or "unix:" (repeatable).
  --force              Allow a large shrink, or replace a file this tool
                       did not write.
  --test               With --dry-run: also run the nginx syntax test.
  --quiet              Print only warnings and errors.
  --no-syslog          Do not send messages to syslog.

Exit codes: 0 ok, 1 usage/config/permission/write, 2 fetch, 3 validation,
4 nginx test failed (previous state restored), 5 reload failed (new valid
snippet kept), 6 another run holds the lock, 10 --diff found differences.
USAGE
}

# ---------------------------------------------------------------------------
# Command line and config file
# ---------------------------------------------------------------------------

set_mode() {
	if [[ $MODE != update ]]; then
		die "$EX_CONFIG" "only one mode at a time ($MODE and $1 given)"
	fi
	MODE=$1
}

need_arg() {
	if (($2 < 2)); then
		die "$EX_CONFIG" "option $1 needs a value"
	fi
}

parse_args() {
	while (($# > 0)); do
		case $1 in
		--dry-run) set_mode dry-run ;;
		--diff) set_mode diff ;;
		--rollback) set_mode rollback ;;
		--release) set_mode release ;;
		--verify) set_mode verify ;;
		--status) set_mode status ;;
		--version) set_mode version ;;
		-h | --help) set_mode help ;;
		--config)
			need_arg "$1" "$#"
			CONFIG_FILE=$2
			CONFIG_EXPLICIT=1
			shift
			;;
		--output)
			need_arg "$1" "$#"
			FLAG_VAL[CFRN_OUTPUT]=$2
			shift
			;;
		--header)
			need_arg "$1" "$#"
			FLAG_VAL[CFRN_HEADER]=$2
			shift
			;;
		--extra-trusted)
			need_arg "$1" "$#"
			FLAG_EXTRA+=("$2")
			shift
			;;
		--recursive) FLAG_VAL[CFRN_RECURSIVE]=yes ;;
		--force) FORCE=1 ;;
		--test) WITH_TEST=1 ;;
		--quiet) QUIET=1 ;;
		--no-syslog) SYSLOG_ON=0 ;;
		*) die "$EX_CONFIG" "unknown argument: $(quote_line "$1") (see --help)" ;;
		esac
		shift
	done
	if [[ $WITH_TEST == 1 && $MODE != dry-run ]]; then
		die "$EX_CONFIG" "--test is only valid with --dry-run"
	fi
}

# trim TEXT: strip leading and trailing white space into TRIMMED (no subshell).
TRIMMED=
trim() {
	TRIMMED=$1
	TRIMMED="${TRIMMED#"${TRIMMED%%[![:space:]]*}"}"
	TRIMMED="${TRIMMED%"${TRIMMED##*[![:space:]]}"}"
}

# Characters an unquoted value may not contain (shell syntax or spaces).
readonly UNSAFE_UNQUOTED='[][:space:]"'"'"'`$\\;&|<>()]'

# The config file is data. It is parsed line by line and never sourced.
load_config_file() {
	local file=$1 n=0 line key value
	if [[ ! -r $file ]]; then
		die "$EX_CONFIG" "cannot read config file $file"
	fi
	while IFS= read -r line || [[ -n $line ]]; do
		n=$((n + 1))
		line=${line%$'\r'}
		trim "$line"
		line=$TRIMMED
		if [[ -z $line || $line == \#* ]]; then
			continue
		fi
		if [[ ! $line =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
			die "$EX_CONFIG" "$file:$n: expected KEY=value"
		fi
		key=${BASH_REMATCH[1]}
		value=${BASH_REMATCH[2]}
		if [[ -z ${CFG[$key]+x} ]]; then
			die "$EX_CONFIG" "$file:$n: unknown setting $key"
		fi
		if [[ $value =~ ^\"([^\"\\\$\`]*)\"$ ]]; then
			value=${BASH_REMATCH[1]}
		elif [[ $value =~ ^\'([^\']*)\'$ ]]; then
			value=${BASH_REMATCH[1]}
		elif [[ $value =~ $UNSAFE_UNQUOTED ]]; then
			die "$EX_CONFIG" "$file:$n: quote values that contain spaces or shell characters"
		fi
		CFG[$key]=$value
	done <"$file"
}

is_uint() {
	[[ $1 =~ ^[0-9]{1,9}$ ]]
}

need_uint() { # key min max
	local key=$1 v=${CFG[$1]}
	if ! is_uint "$v" || ((10#$v < $2 || 10#$v > $3)); then
		die "$EX_CONFIG" "$key must be a whole number from $2 to $3 (got '$(quote_line "$v")')"
	fi
	CFG[$key]=$((10#$v))
}

need_bool() {
	case ${CFG[$1]} in
	yes | no) ;;
	*) die "$EX_CONFIG" "$1 must be yes or no (got '$(quote_line "${CFG[$1]}")')" ;;
	esac
}

# Paths end up in nginx configuration, a command line and sudoers rules, so
# they are held to a small, safe alphabet.
need_path() {
	local key=$1 v=${CFG[$1]}
	if [[ ! $v =~ ^/[A-Za-z0-9._/@+-]*$ || $v == */ || $v == *//* || $v == */../* || $v == */.. || $v == */./* ]]; then
		die "$EX_CONFIG" "$key must be a plain absolute path (got '$(quote_line "$v")')"
	fi
}

need_words() { # key: whitespace separated words, no shell syntax
	local key=$1 w
	local -a words=()
	read -r -a words <<<"${CFG[$key]}" || true
	for w in "${words[@]+"${words[@]}"}"; do
		if [[ ! $w =~ ^[A-Za-z0-9._/@:=+,-]+$ ]]; then
			die "$EX_CONFIG" "$key contains an unsafe word '$(quote_line "$w")'"
		fi
	done
}

# URL check shared by the config and by every redirect. Prints the host.
url_host() {
	local url=$1
	if [[ $url =~ ^https://([A-Za-z0-9.-]+)(:[0-9]{1,5})?(/[A-Za-z0-9._~/%+=,:@-]*)?$ ]]; then
		printf '%s' "${BASH_REMATCH[1],,}"
		return 0
	fi
	return 1
}

check_config_url() {
	local key=$1 url=${CFG[$1]} host
	if [[ $url != https://* ]]; then
		die "$EX_CONFIG" "$key must be an https:// URL (got '$(quote_line "$url")')"
	fi
	if ! host=$(url_host "$url"); then
		die "$EX_CONFIG" "$key is not a valid URL (got '$(quote_line "$url")')"
	fi
	if [[ ${CFG[CFRN_PIN_HOST]} == yes && $host != "$PINNED_HOST" ]]; then
		die "$EX_CONFIG" "$key points at $host; only $PINNED_HOST is allowed while CFRN_PIN_HOST=yes"
	fi
}

load_settings() {
	local key file
	file=$CONFIG_FILE
	if [[ -z $file && -n ${CFRN_CONFIG:-} ]]; then
		file=$CFRN_CONFIG
		CONFIG_EXPLICIT=1
	fi
	if [[ -z $file ]]; then
		file=$DEFAULT_CONFIG
	fi
	CONFIG_FILE=$file
	if [[ -e $file || $CONFIG_EXPLICIT == 1 ]]; then
		load_config_file "$file"
	fi
	for key in "${!ENV_VAL[@]}"; do
		CFG[$key]=${ENV_VAL[$key]}
	done
	for key in "${!FLAG_VAL[@]}"; do
		CFG[$key]=${FLAG_VAL[$key]}
	done
	if ((${#FLAG_EXTRA[@]} > 0)); then
		CFG[CFRN_EXTRA_TRUSTED]="${CFG[CFRN_EXTRA_TRUSTED]} ${FLAG_EXTRA[*]}"
	fi

	need_bool CFRN_SYSLOG
	if [[ ${CFG[CFRN_SYSLOG]} == no ]]; then
		SYSLOG_ON=0
	fi
	if [[ ! ${CFG[CFRN_SYSLOG_TAG]} =~ ^[A-Za-z0-9._-]{1,48}$ ]]; then
		die "$EX_CONFIG" "CFRN_SYSLOG_TAG must be letters, digits, dot, dash or underscore"
	fi
	SYSLOG_TAG=${CFG[CFRN_SYSLOG_TAG]}

	need_path CFRN_OUTPUT
	need_path CFRN_STATE_DIR
	OUTPUT=${CFG[CFRN_OUTPUT]}
	OUTPUT_DIR=$(dirname -- "$OUTPUT")
	STATE_DIR=${CFG[CFRN_STATE_DIR]}
	if [[ -z ${CFG[CFRN_STAGING_DIR]} ]]; then
		local parent
		parent=$(dirname -- "$OUTPUT_DIR")
		CFG[CFRN_STAGING_DIR]="${parent%/}/.cloudflare-realip-nginx"
	fi
	need_path CFRN_STAGING_DIR
	STAGING_DIR=${CFG[CFRN_STAGING_DIR]}
	if [[ $STAGING_DIR == "$OUTPUT_DIR" ]]; then
		die "$EX_CONFIG" "CFRN_STAGING_DIR must not be the directory nginx includes the snippet from"
	fi
	if [[ -n ${CFG[CFRN_METRICS_DIR]} ]]; then
		need_path CFRN_METRICS_DIR
	fi

	need_bool CFRN_PIN_HOST
	check_config_url CFRN_URL_V4
	check_config_url CFRN_URL_V6
	URL_V4=${CFG[CFRN_URL_V4]}
	URL_V6=${CFG[CFRN_URL_V6]}

	HEADER=${CFG[CFRN_HEADER]}
	if [[ ! $HEADER =~ ^[A-Za-z0-9-]{1,64}$ ]]; then
		die "$EX_CONFIG" "header name must be letters, digits and hyphens only (got '$(quote_line "$HEADER")')"
	fi
	need_bool CFRN_RECURSIVE

	need_uint CFRN_MIN_COUNT_V4 1 100000
	need_uint CFRN_MIN_COUNT_V6 1 100000
	need_uint CFRN_MAX_COUNT 1 100000
	if ((CFG[CFRN_MIN_COUNT_V4] > CFG[CFRN_MAX_COUNT] || CFG[CFRN_MIN_COUNT_V6] > CFG[CFRN_MAX_COUNT])); then
		die "$EX_CONFIG" "minimum counts must not exceed CFRN_MAX_COUNT"
	fi
	need_uint CFRN_MIN_PREFIX_V4 1 32
	need_uint CFRN_MIN_PREFIX_V6 1 128
	need_uint CFRN_MAX_SHRINK_PERCENT 0 100
	need_uint CFRN_CONNECT_TIMEOUT 1 300
	need_uint CFRN_TOTAL_TIMEOUT 1 3600
	need_uint CFRN_ATTEMPTS 1 10
	need_uint CFRN_RETRY_DELAY 0 300
	need_uint CFRN_MAX_BODY_BYTES 1024 10485760
	need_uint CFRN_STALE_DAYS 1 3650
	need_uint CFRN_HOLD_DAYS 1 3650

	need_words CFRN_NGINX
	need_words CFRN_TEST_COMMAND
	need_words CFRN_DUMP_COMMAND
	need_words CFRN_RELOAD_COMMAND
	need_words CFRN_PRIV_HELPER
	if [[ ! ${CFG[CFRN_NGINX]} =~ ^[A-Za-z0-9._/+-]+$ ]]; then
		die "$EX_CONFIG" "CFRN_NGINX must be a single command name or path"
	fi
	NGINX_BIN=${CFG[CFRN_NGINX]}
	if [[ ! ${CFG[CFRN_SERVICE_NAME]} =~ ^[A-Za-z0-9@._-]+$ ]]; then
		die "$EX_CONFIG" "CFRN_SERVICE_NAME must be a plain unit name"
	fi
	case ${CFG[CFRN_SERVICE_MANAGER]} in
	auto | systemd | none) ;;
	*) die "$EX_CONFIG" "CFRN_SERVICE_MANAGER must be auto, systemd or none" ;;
	esac
	need_path CFRN_PID_FILE

	parse_extras
	resolve_commands

	if [[ ${CFG[CFRN_PIN_HOST]} == no ]]; then
		warn "host pinning is off (CFRN_PIN_HOST=no): lists may come from any HTTPS host"
	fi
	if [[ ${CFG[CFRN_RECURSIVE]} == yes && ${HEADER,,} == cf-connecting-ip ]]; then
		warn "real_ip_recursive has no effect with CF-Connecting-IP, which carries one address"
	fi
}

resolve_commands() {
	local -a words=()
	if [[ ${CFG[CFRN_SERVICE_MANAGER]} == auto ]]; then
		if [[ -d /run/systemd/system ]] && command -v systemctl >/dev/null 2>&1; then
			SERVICE_MANAGER=systemd
		else
			SERVICE_MANAGER=none
		fi
	else
		SERVICE_MANAGER=${CFG[CFRN_SERVICE_MANAGER]}
	fi

	if [[ -n ${CFG[CFRN_TEST_COMMAND]} ]]; then
		read -r -a TEST_CMD <<<"${CFG[CFRN_TEST_COMMAND]}"
	else
		TEST_CMD=("$NGINX_BIN" -t)
	fi
	if [[ -n ${CFG[CFRN_DUMP_COMMAND]} ]]; then
		read -r -a DUMP_CMD <<<"${CFG[CFRN_DUMP_COMMAND]}"
	else
		DUMP_CMD=("$NGINX_BIN" -T)
	fi
	if [[ -n ${CFG[CFRN_RELOAD_COMMAND]} ]]; then
		read -r -a RELOAD_CMD <<<"${CFG[CFRN_RELOAD_COMMAND]}"
	elif [[ $SERVICE_MANAGER == systemd ]]; then
		RELOAD_CMD=(systemctl reload "${CFG[CFRN_SERVICE_NAME]}")
	else
		RELOAD_CMD=("$NGINX_BIN" -s reload)
	fi

	local uid
	uid=$(id -u)
	if [[ $uid == 0 ]]; then
		IS_ROOT=1
	fi
	HELPER=()
	case ${CFG[CFRN_PRIV_HELPER]} in
	auto)
		if [[ $IS_ROOT == 0 ]]; then
			HELPER=(sudo -n)
		fi
		;;
	none | "") ;;
	*)
		read -r -a words <<<"${CFG[CFRN_PRIV_HELPER]}"
		if [[ $IS_ROOT == 0 ]]; then
			HELPER=("${words[@]}")
		fi
		;;
	esac
}

parse_extras() {
	local e
	local -a raw=()
	local -A seen=()
	EXTRAS=()
	read -r -a raw <<<"${CFG[CFRN_EXTRA_TRUSTED]}" || true
	for e in "${raw[@]+"${raw[@]}"}"; do
		if [[ $e == unix: ]]; then
			IP_CANON=unix:
		elif [[ $e == *:* ]]; then
			if ! parse_v6 "$e"; then
				die "$EX_CONFIG" "extra trusted address '$(quote_line "$e")': $IP_ERR"
			fi
		else
			if ! parse_v4 "$e"; then
				die "$EX_CONFIG" "extra trusted address '$(quote_line "$e")': $IP_ERR"
			fi
		fi
		if [[ -n ${seen[$IP_CANON]+x} ]]; then
			warn "duplicate extra trusted address $IP_CANON removed"
			continue
		fi
		seen[$IP_CANON]=1
		EXTRAS+=("$IP_CANON")
	done
}

# ---------------------------------------------------------------------------
# Address parsing. Pure bash, no helpers. Each parser sets IP_CANON (the
# canonical text), IP_PREFIX, IP_KEY (a fixed width sort key) and either
# IP_INT (IPv4) or IP_GROUPS (IPv6, eight integers). On failure it sets
# IP_ERR and returns 1 (syntax) or 2 (host bits set).
# ---------------------------------------------------------------------------

IP_CANON= IP_PREFIX=0 IP_KEY= IP_INT=0 IP_ERR=
declare -a IP_GROUPS=()

parse_v4() {
	local s=$1 p o i
	local -a oct=()
	IP_ERR=
	if [[ $s != */* ]]; then
		IP_ERR="no prefix length"
		return 1
	fi
	if [[ ! $s =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,3})$ ]]; then
		IP_ERR="not an IPv4 range"
		return 1
	fi
	oct=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
	p=${BASH_REMATCH[5]}
	for o in "${oct[@]}"; do
		if [[ ! $o =~ ^(0|[1-9][0-9]{0,2})$ ]]; then
			IP_ERR="octet with a leading zero"
			return 1
		fi
		if ((o > 255)); then
			IP_ERR="octet above 255"
			return 1
		fi
	done
	if [[ ! $p =~ ^(0|[1-9][0-9]?)$ ]] || ((p > 32)); then
		IP_ERR="prefix length outside 0 to 32"
		return 1
	fi
	IP_INT=0
	for i in 0 1 2 3; do
		IP_INT=$(((IP_INT << 8) | oct[i]))
	done
	if ((IP_INT & ((1 << (32 - p)) - 1))); then
		IP_ERR="host bits set below the /$p prefix"
		return 2
	fi
	IP_PREFIX=$p
	IP_CANON="${oct[0]}.${oct[1]}.${oct[2]}.${oct[3]}/$p"
	printf -v IP_KEY '4 %08x %03d' "$IP_INT" "$p"
	return 0
}

parse_v6() {
	local s=$1 addr p head tail g i n bits mask
	local -a hg=() tg=() all=()
	IP_ERR=
	if [[ $s != */* ]]; then
		IP_ERR="no prefix length"
		return 1
	fi
	addr=${s%/*}
	p=${s##*/}
	if [[ ! $p =~ ^(0|[1-9][0-9]{0,2})$ ]] || ((p > 128)); then
		IP_ERR="prefix length outside 0 to 128"
		return 1
	fi
	if [[ ! $addr =~ ^[0-9A-Fa-f:]+$ ]]; then
		IP_ERR="not an IPv6 range (only hex digits and colons are allowed)"
		return 1
	fi
	if [[ $addr == *::*::* || $addr == *:::* ]]; then
		IP_ERR="more than one '::'"
		return 1
	fi
	if [[ $addr == *::* ]]; then
		head=${addr%%::*}
		tail=${addr#*::}
		if [[ $head == :* || $tail == *: ]]; then
			IP_ERR="empty group"
			return 1
		fi
		if [[ -n $head ]]; then
			IFS=: read -r -a hg <<<"$head"
		fi
		if [[ -n $tail ]]; then
			IFS=: read -r -a tg <<<"$tail"
		fi
		n=$((${#hg[@]} + ${#tg[@]}))
		if ((n > 7)); then
			IP_ERR="too many groups"
			return 1
		fi
		all=("${hg[@]+"${hg[@]}"}")
		for ((i = n; i < 8; i++)); do
			all+=(0)
		done
		all+=("${tg[@]+"${tg[@]}"}")
	else
		if [[ $addr == :* || $addr == *: ]]; then
			IP_ERR="empty group"
			return 1
		fi
		IFS=: read -r -a all <<<"$addr"
		if ((${#all[@]} != 8)); then
			IP_ERR="needs eight groups or one '::'"
			return 1
		fi
	fi
	IP_GROUPS=()
	for g in "${all[@]}"; do
		if [[ ! $g =~ ^[0-9A-Fa-f]{1,4}$ ]]; then
			IP_ERR="bad group '$(quote_line "$g")'"
			return 1
		fi
		IP_GROUPS+=($((16#$g)))
	done
	for ((i = 0; i < 8; i++)); do
		bits=$((p - 16 * i))
		if ((bits >= 16)); then
			continue
		fi
		if ((bits <= 0)); then
			mask=0xffff
		else
			mask=$(((1 << (16 - bits)) - 1))
		fi
		if ((IP_GROUPS[i] & mask)); then
			IP_ERR="host bits set below the /$p prefix"
			return 2
		fi
	done
	IP_PREFIX=$p
	v6_text
	IP_CANON="$V6_TEXT/$p"
	printf -v IP_KEY '6 %04x%04x%04x%04x%04x%04x%04x%04x %03d' "${IP_GROUPS[@]}" "$p"
	return 0
}

# RFC 5952 text for IP_GROUPS, into V6_TEXT: lower case, no leading zeros,
# the longest run of two or more zero groups (the first on a tie) as "::".
V6_TEXT=
v6_text() {
	local i best_start=-1 best_len=0 cur_start=-1 cur_len=0 out= hex
	for ((i = 0; i < 8; i++)); do
		if ((IP_GROUPS[i] == 0)); then
			if ((cur_start < 0)); then
				cur_start=$i
				cur_len=0
			fi
			cur_len=$((cur_len + 1))
			if ((cur_len > best_len)); then
				best_len=$cur_len
				best_start=$cur_start
			fi
		else
			cur_start=-1
		fi
	done
	if ((best_len < 2)); then
		best_start=-1
	fi
	for ((i = 0; i < 8; i++)); do
		if ((i == best_start)); then
			out+="::"
			i=$((i + best_len - 1))
			continue
		fi
		if [[ -n $out && $out != *:: ]]; then
			out+=":"
		fi
		printf -v hex '%x' "${IP_GROUPS[i]}"
		out+=$hex
	done
	V6_TEXT=$out
}

v4_overlap() { # int1 p1 int2 p2
	local m=$(($2 < $4 ? $2 : $4)) mask
	if ((m == 0)); then
		return 0
	fi
	mask=$(((0xffffffff << (32 - m)) & 0xffffffff))
	(((($1 & mask) == ($3 & mask))))
}

v6_overlap() { # "g0..g7" p1 "g0..g7" p2
	local -a a=() b=()
	local m i bits
	read -r -a a <<<"$1"
	read -r -a b <<<"$3"
	m=$(($2 < $4 ? $2 : $4))
	for ((i = 0; i < 8; i++)); do
		bits=$((m - 16 * i))
		if ((bits <= 0)); then
			return 0
		fi
		if ((bits >= 16)); then
			if ((a[i] != b[i])); then
				return 1
			fi
		elif (((a[i] >> (16 - bits)) != (b[i] >> (16 - bits)))); then
			return 1
		fi
	done
	return 0
}

# Space that must never be trusted from a fetched list (V4).
readonly -a RESERVED_V4=(
	"0.0.0.0/8 this-network" "10.0.0.0/8 private" "100.64.0.0/10 carrier-grade-NAT"
	"127.0.0.0/8 loopback" "169.254.0.0/16 link-local" "172.16.0.0/12 private"
	"192.0.0.0/24 IETF-protocol" "192.0.2.0/24 documentation" "192.168.0.0/16 private"
	"198.18.0.0/15 benchmarking" "198.51.100.0/24 documentation"
	"203.0.113.0/24 documentation" "224.0.0.0/4 multicast" "240.0.0.0/4 reserved"
)
readonly -a RESERVED_V6=(
	"::/128 unspecified" "::1/128 loopback" "::ffff:0:0/96 IPv4-mapped" "100::/64 discard"
	"2001:db8::/32 documentation" "3fff::/20 documentation" "fc00::/7 unique-local"
	"fe80::/10 link-local" "ff00::/8 multicast"
)
declare -a RES4_INT=() RES4_P=() RES4_NAME=() RES6_G=() RES6_P=() RES6_NAME=()

load_reserved() {
	local r
	for r in "${RESERVED_V4[@]}"; do
		parse_v4 "${r% *}"
		RES4_INT+=("$IP_INT")
		RES4_P+=("$IP_PREFIX")
		RES4_NAME+=("${r##* } ${r% *}")
	done
	for r in "${RESERVED_V6[@]}"; do
		parse_v6 "${r% *}"
		RES6_G+=("${IP_GROUPS[*]}")
		RES6_P+=("$IP_PREFIX")
		RES6_NAME+=("${r##* } ${r% *}")
	done
}

# Validate one entry from a fetched list. Family is 4 or 6.
check_entry() {
	local fam=$1 raw=$2 i floor
	if [[ $fam == 4 && $raw == *:* ]]; then
		IP_ERR="IPv6 entry in the IPv4 list"
		return 1
	fi
	if [[ $fam == 6 && $raw =~ ^[0-9.]+(/[0-9]*)?$ ]]; then
		IP_ERR="IPv4 entry in the IPv6 list"
		return 1
	fi
	if [[ $fam == 4 ]]; then
		parse_v4 "$raw" || return 1
		if ((IP_PREFIX == 0)); then
			IP_ERR="the default route is never trusted"
			return 1
		fi
		for i in "${!RES4_INT[@]}"; do
			if v4_overlap "$IP_INT" "$IP_PREFIX" "${RES4_INT[i]}" "${RES4_P[i]}"; then
				IP_ERR="overlaps ${RES4_NAME[i]}"
				return 1
			fi
		done
		floor=${CFG[CFRN_MIN_PREFIX_V4]}
	else
		parse_v6 "$raw" || return 1
		if ((IP_PREFIX == 0)); then
			IP_ERR="the default route is never trusted"
			return 1
		fi
		for i in "${!RES6_G[@]}"; do
			if v6_overlap "${IP_GROUPS[*]}" "$IP_PREFIX" "${RES6_G[i]}" "${RES6_P[i]}"; then
				IP_ERR="overlaps ${RES6_NAME[i]}"
				return 1
			fi
		done
		floor=${CFG[CFRN_MIN_PREFIX_V6]}
	fi
	if ((IP_PREFIX < floor)); then
		IP_ERR="prefix /$IP_PREFIX is wider than the floor /$floor"
		return 1
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Fetch
# ---------------------------------------------------------------------------

FETCH_ERR=

# One attempt. Returns 0 ok, 1 retryable, 2 fatal fetch error, 3 the body is
# not acceptable (validation failure).
fetch_once() {
	local url=$1 out=$2 current=$1 hops=0 rc host status ctype location
	local errfile="$WORKDIR/curl.err" metafile="$WORKDIR/curl.meta"
	local -a meta=()
	while :; do
		if [[ $current != https://* ]]; then
			FETCH_ERR="refused redirect from $url to a non-HTTPS URL"
			return 2
		fi
		if ! host=$(url_host "$current"); then
			FETCH_ERR="refused redirect from $url to an unusable URL"
			return 2
		fi
		if [[ ${CFG[CFRN_PIN_HOST]} == yes && $host != "$PINNED_HOST" ]]; then
			FETCH_ERR="refused redirect from $url to host $host (pinned to $PINNED_HOST)"
			return 2
		fi
		: >"$out"
		rc=0
		curl --silent --show-error \
			--proto =https --tlsv1.2 \
			--connect-timeout "${CFG[CFRN_CONNECT_TIMEOUT]}" \
			--max-time "${CFG[CFRN_TOTAL_TIMEOUT]}" \
			--max-filesize "${CFG[CFRN_MAX_BODY_BYTES]}" \
			--user-agent "$PROG/$VERSION" \
			--header "Accept: text/plain" \
			--output "$out" \
			--write-out '%{http_code}\n%{content_type}\n%{redirect_url}\n' \
			-- "$current" >"$metafile" 2>"$errfile" || rc=$?
		mapfile -t meta <"$metafile"
		status=${meta[0]:-000}
		ctype=${meta[1]:-}
		location=${meta[2]:-}
		if [[ $rc != 0 ]]; then
			local why
			why=$(head -n 1 "$errfile" 2>/dev/null || true)
			FETCH_ERR="$current: curl exit $rc: $(quote_line "${why:-no message}")"
			case $rc in
			63)
				FETCH_ERR="$current: body larger than ${CFG[CFRN_MAX_BODY_BYTES]} bytes, transfer aborted"
				return 3
				;;
			1 | 3 | 35 | 51 | 53 | 54 | 58 | 59 | 60 | 64 | 66 | 77 | 80 | 82 | 83 | 90 | 91)
				return 2
				;;
			*) return 1 ;;
			esac
		fi
		case $status in
		200) break ;;
		301 | 302 | 303 | 307 | 308)
			hops=$((hops + 1))
			if ((hops > MAX_REDIRECTS)); then
				FETCH_ERR="$url: more than $MAX_REDIRECTS redirects"
				return 2
			fi
			if [[ -z $location ]]; then
				FETCH_ERR="$current: HTTP $status without a Location"
				return 2
			fi
			current=$location
			continue
			;;
		429 | 5[0-9][0-9])
			FETCH_ERR="$current: HTTP $status"
			return 1
			;;
		*)
			FETCH_ERR="$current: HTTP $status"
			return 2
			;;
		esac
	done
	ctype=${ctype%%;*}
	trim "${ctype,,}"
	ctype=$TRIMMED
	if [[ $ctype != text/plain ]]; then
		FETCH_ERR="$current: content type '$(quote_line "$ctype")', expected text/plain"
		return 3
	fi
	local size
	size=$(wc -c <"$out")
	if ((size > CFG[CFRN_MAX_BODY_BYTES])); then
		FETCH_ERR="$current: body larger than ${CFG[CFRN_MAX_BODY_BYTES]} bytes"
		return 3
	fi
	return 0
}

fetch_list() { # url outfile
	local url=$1 out=$2 attempt=1 rc delay=${CFG[CFRN_RETRY_DELAY]}
	while :; do
		rc=0
		fetch_once "$url" "$out" || rc=$?
		case $rc in
		0) return 0 ;;
		2) die "$EX_FETCH" "fetch failed: $FETCH_ERR" ;;
		3) die "$EX_INVALID" "validation failed: $FETCH_ERR" ;;
		esac
		if ((attempt >= CFG[CFRN_ATTEMPTS])); then
			die "$EX_FETCH" "fetch failed after $attempt attempts: $FETCH_ERR"
		fi
		warn "attempt $attempt failed, retrying in ${delay}s: $FETCH_ERR"
		sleep "$delay"
		delay=$((delay * 2))
		attempt=$((attempt + 1))
	done
}

# Parse and validate one fetched list into the named array (LIST_V4/LIST_V6).
load_list() { # family file url
	local fam=$1 file=$2 url=$3 clean="$2.clean" line n=0 bad
	local -a keyed=()
	local -A seen=()
	local min max
	if [[ $(head -c 3 "$file" | od -An -tx1 | tr -d ' \n') == efbbbf ]]; then
		tail -c +4 "$file" >"$clean"
	else
		cp -- "$file" "$clean"
	fi
	bad=$(LC_ALL=C tr -d '\t\r\n\040-\176' <"$clean" | wc -c)
	if ((bad > 0)); then
		die "$EX_INVALID" "validation failed: $url: body contains bytes that are not printable ASCII"
	fi
	while IFS= read -r line || [[ -n $line ]]; do
		n=$((n + 1))
		line=${line%$'\r'}
		trim "$line"
		line=$TRIMMED
		if [[ -z $line ]]; then
			continue
		fi
		if ! check_entry "$fam" "$line"; then
			die "$EX_INVALID" "validation failed: $url line $n: $IP_ERR: '$(quote_line "$line")'"
		fi
		if [[ -n ${seen[$IP_CANON]+x} ]]; then
			warn "$url line $n: duplicate range $IP_CANON removed"
			continue
		fi
		seen[$IP_CANON]=1
		keyed+=("$IP_KEY $IP_CANON")
	done <"$clean"
	if ((${#keyed[@]} == 0)); then
		die "$EX_INVALID" "validation failed: $url: empty list"
	fi
	min=${CFG[CFRN_MIN_COUNT_V$fam]}
	max=${CFG[CFRN_MAX_COUNT]}
	if ((${#keyed[@]} < min || ${#keyed[@]} > max)); then
		die "$EX_INVALID" "validation failed: $url: ${#keyed[@]} ranges, expected $min to $max"
	fi
	local -a sorted=()
	mapfile -t sorted < <(printf '%s\n' "${keyed[@]}" | LC_ALL=C sort)
	local -a canon=()
	for line in "${sorted[@]}"; do
		canon+=("${line##* }")
	done
	if [[ $fam == 4 ]]; then
		LIST_V4=("${canon[@]}")
	else
		LIST_V6=("${canon[@]}")
	fi
}

# ---------------------------------------------------------------------------
# Render and compare
# ---------------------------------------------------------------------------

render() {
	local r
	printf '%s\n' "$MARKER"
	printf '# Tool: %s %s\n' "$PROG" "$VERSION"
	printf '# Source: %s\n' "$URL_V4" "$URL_V6"
	printf '# Include once in the http context, before any limit_req_zone, geo or map\n'
	printf '# keyed on the client address.\n'
	printf '\n# Cloudflare IPv4 ranges\n'
	for r in "${LIST_V4[@]}"; do
		printf 'set_real_ip_from %s;\n' "$r"
	done
	printf '\n# Cloudflare IPv6 ranges\n'
	for r in "${LIST_V6[@]}"; do
		printf 'set_real_ip_from %s;\n' "$r"
	done
	if ((${#EXTRAS[@]} > 0)); then
		printf '\n# Extra trusted addresses (set by the operator)\n'
		for r in "${EXTRAS[@]}"; do
			printf 'set_real_ip_from %s;\n' "$r"
		done
	fi
	printf '\nreal_ip_header %s;\n' "$HEADER"
	if [[ ${CFG[CFRN_RECURSIVE]} == yes ]]; then
		printf 'real_ip_recursive on;\n'
	fi
}

is_ours() { # file
	local first
	first=$(head -n 1 -- "$1" 2>/dev/null || true)
	[[ $first == "$MARKER" ]]
}

# canon_any VALUE: canonical form of any set_real_ip_from value, into CANON.
CANON=
canon_any() {
	local v=$1
	if [[ $v == unix:* ]]; then
		CANON=$v
	elif [[ $v == *:* ]] && parse_v6 "$v"; then
		CANON=$IP_CANON
	elif [[ $v != *:* ]] && parse_v4 "$v"; then
		CANON=$IP_CANON
	else
		CANON=${v,,}
	fi
}

read_previous() { # file
	local line v section=cloudflare
	PREV_V4=()
	PREV_V6=()
	PREV_ALL=()
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line == "# Extra trusted addresses"* ]]; then
			section=extra
		fi
		if [[ $line =~ ^[[:space:]]*set_real_ip_from[[:space:]]+([^\;[:space:]]+)[[:space:]]*\; ]]; then
			canon_any "${BASH_REMATCH[1]}"
			v=$CANON
			PREV_ALL+=("$v")
			if [[ $section == cloudflare && $v != unix:* ]]; then
				if [[ $v == *:* ]]; then
					PREV_V6+=("$v")
				else
					PREV_V4+=("$v")
				fi
			fi
		fi
	done <"$1"
}

compute_changes() {
	local v
	local -A old=() new=()
	ADDED=()
	REMOVED=()
	for v in "${PREV_ALL[@]+"${PREV_ALL[@]}"}"; do
		old[$v]=1
	done
	for v in "${LIST_V4[@]}" "${LIST_V6[@]}" "${EXTRAS[@]+"${EXTRAS[@]}"}"; do
		new[$v]=1
		if [[ -z ${old[$v]+x} ]]; then
			ADDED+=("$v")
		fi
	done
	for v in "${PREV_ALL[@]+"${PREV_ALL[@]}"}"; do
		if [[ -z ${new[$v]+x} ]]; then
			REMOVED+=("$v")
		fi
	done
}

# V10: refuse a run that drops more than the allowed share of a family.
shrink_guard() {
	local fam v removed prev limit=${CFG[CFRN_MAX_SHRINK_PERCENT]}
	local -A cur=()
	for fam in 4 6; do
		local -a prevlist=() curlist=()
		if [[ $fam == 4 ]]; then
			prevlist=("${PREV_V4[@]+"${PREV_V4[@]}"}")
			curlist=("${LIST_V4[@]}")
		else
			prevlist=("${PREV_V6[@]+"${PREV_V6[@]}"}")
			curlist=("${LIST_V6[@]}")
		fi
		prev=${#prevlist[@]}
		if ((prev == 0)); then
			continue
		fi
		cur=()
		for v in "${curlist[@]}"; do
			cur[$v]=1
		done
		removed=0
		for v in "${prevlist[@]}"; do
			if [[ -z ${cur[$v]+x} ]]; then
				removed=$((removed + 1))
			fi
		done
		if ((removed * 100 > limit * prev)); then
			if [[ $FORCE == 1 ]]; then
				warn "IPv$fam list shrinks by $removed of $prev ranges; allowed by --force"
			else
				die "$EX_INVALID" "validation failed: IPv$fam list would drop $removed of $prev ranges (limit ${limit} percent); rerun with --force if this is expected"
			fi
		fi
	done
}

sha256_of() {
	if [[ -f $1 ]]; then
		sha256sum -- "$1" | cut -d ' ' -f 1
	else
		printf 'none'
	fi
}

# ---------------------------------------------------------------------------
# State file
# ---------------------------------------------------------------------------

state_load() {
	local file="$STATE_DIR/state" line
	STATE=()
	if [[ ! -f $file ]]; then
		return 0
	fi
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^([a-z0-9_]+)=([A-Za-z0-9._:-]*)$ ]]; then
			STATE[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
		fi
	done <"$file"
}

state_save() {
	local tmp k
	tmp=$(mktemp "$STATE_DIR/.state.XXXXXX")
	CLEANUP_FILES+=("$tmp")
	{
		printf '# %s state. Written by the tool on every run; do not edit.\n' "$PROG"
		for k in "${STATE_KEYS[@]}"; do
			if [[ -n ${STATE[$k]+x} ]]; then
				printf '%s=%s\n' "$k" "${STATE[$k]}"
			fi
		done
	} >"$tmp"
	chmod 0640 "$tmp"
	mv -f -- "$tmp" "$STATE_DIR/state"
}

record_run() {
	local rc=$1
	STATE[last_run]=$(date +%s)
	STATE[last_exit]=$rc
	STATE[last_result]=$RUN_RESULT
	if [[ $rc == 0 && $RUN_SUCCESS == 1 ]]; then
		STATE[last_success]=${STATE[last_run]}
	fi
	state_save
	write_metrics
}

write_metrics() {
	local dir=${CFG[CFRN_METRICS_DIR]} tmp
	if [[ -z $dir ]]; then
		return 0
	fi
	if [[ ! -d $dir ]]; then
		warn "metrics directory $dir does not exist; metrics not written"
		return 0
	fi
	tmp=$(mktemp "$dir/.cloudflare_realip_nginx.XXXXXX")
	CLEANUP_FILES+=("$tmp")
	{
		printf '# HELP cloudflare_realip_nginx_last_run_timestamp_seconds Time of the last run.\n'
		printf '# TYPE cloudflare_realip_nginx_last_run_timestamp_seconds gauge\n'
		printf 'cloudflare_realip_nginx_last_run_timestamp_seconds %s\n' "${STATE[last_run]:-0}"
		printf '# HELP cloudflare_realip_nginx_last_run_exit_code Exit code of the last run.\n'
		printf '# TYPE cloudflare_realip_nginx_last_run_exit_code gauge\n'
		printf 'cloudflare_realip_nginx_last_run_exit_code %s\n' "${STATE[last_exit]:-0}"
		printf '# HELP cloudflare_realip_nginx_last_success_timestamp_seconds Time of the last successful run.\n'
		printf '# TYPE cloudflare_realip_nginx_last_success_timestamp_seconds gauge\n'
		printf 'cloudflare_realip_nginx_last_success_timestamp_seconds %s\n' "${STATE[last_success]:-0}"
		printf '# HELP cloudflare_realip_nginx_ranges Trusted Cloudflare ranges in the live snippet.\n'
		printf '# TYPE cloudflare_realip_nginx_ranges gauge\n'
		printf 'cloudflare_realip_nginx_ranges{family="ipv4"} %s\n' "${STATE[count_v4]:-0}"
		printf 'cloudflare_realip_nginx_ranges{family="ipv6"} %s\n' "${STATE[count_v6]:-0}"
	} >"$tmp"
	chmod 0644 "$tmp"
	mv -f -- "$tmp" "$dir/cloudflare_realip_nginx.prom"
}

# ---------------------------------------------------------------------------
# Locking and preflight
# ---------------------------------------------------------------------------

ensure_state_dir() {
	if [[ ! -d $STATE_DIR ]]; then
		if [[ $IS_ROOT == 1 ]]; then
			mkdir -p -m 0750 -- "$STATE_DIR" || die "$EX_CONFIG" "cannot create state directory $STATE_DIR"
		else
			die "$EX_CONFIG" "state directory $STATE_DIR does not exist; run install.sh or create it for this user"
		fi
	fi
	if [[ ! -w $STATE_DIR ]]; then
		die "$EX_CONFIG" "state directory $STATE_DIR is not writable by uid $(id -u)"
	fi
}

take_lock() {
	local fd
	exec {fd}>>"$STATE_DIR/lock" || die "$EX_CONFIG" "cannot open lock file $STATE_DIR/lock"
	if ! flock -n "$fd"; then
		die "$EX_LOCKED" "another run is in progress (lock $STATE_DIR/lock is held)"
	fi
	LOCK_HELD=1
}

run_priv() {
	if ((${#HELPER[@]} > 0)); then
		"${HELPER[@]}" "$@"
	else
		"$@"
	fi
}

helper_allows() { # command words...
	if [[ ${HELPER[0]} == sudo ]]; then
		sudo -n -l "$@" >/dev/null 2>&1
	else
		return 0
	fi
}

preflight() {
	if ! command -v "$NGINX_BIN" >/dev/null 2>&1; then
		die "$EX_CONFIG" "nginx binary '$NGINX_BIN' not found (set CFRN_NGINX)"
	fi
	if [[ ! -d $OUTPUT_DIR ]]; then
		die "$EX_CONFIG" "target directory $OUTPUT_DIR does not exist; create it or set CFRN_OUTPUT"
	fi
	if [[ -L $OUTPUT ]]; then
		die "$EX_CONFIG" "$OUTPUT is a symlink; point CFRN_OUTPUT at the real file instead"
	fi
	if [[ -e $OUTPUT && ! -f $OUTPUT ]]; then
		die "$EX_CONFIG" "$OUTPUT exists and is not a regular file"
	fi
	if [[ $IS_ROOT == 1 ]]; then
		if [[ ! -w $OUTPUT_DIR ]]; then
			die "$EX_CONFIG" "target directory $OUTPUT_DIR is not writable"
		fi
		if [[ ! -d $STAGING_DIR ]]; then
			mkdir -m 0700 -- "$STAGING_DIR" || die "$EX_CONFIG" "cannot create staging directory $STAGING_DIR"
		fi
		if [[ $(stat -c %d -- "$STAGING_DIR") != "$(stat -c %d -- "$OUTPUT_DIR")" ]]; then
			die "$EX_CONFIG" "staging directory $STAGING_DIR is not on the same filesystem as $OUTPUT_DIR, so the final rename would not be atomic; set CFRN_STAGING_DIR"
		fi
	else
		if ((${#HELPER[@]} == 0)); then
			die "$EX_CONFIG" "running as uid $(id -u) without a privilege helper: the full nginx -t needs root (TLS keys are root-only); set CFRN_PRIV_HELPER or run as root"
		fi
		local -a need=("${TEST_CMD[*]}" "${DUMP_CMD[*]}" "${RELOAD_CMD[*]}" "install -m 0644 $STATE_DIR/staged.conf $OUTPUT")
		local c
		local -a words=()
		for c in "${need[@]}"; do
			read -r -a words <<<"$c"
			if ! helper_allows "${words[@]}"; then
				die "$EX_CONFIG" "privilege helper '${HELPER[*]}' does not allow '$c' without a password; see examples/sudoers"
			fi
		done
		if [[ -e $OUTPUT && ! -r $OUTPUT ]]; then
			die "$EX_CONFIG" "$OUTPUT is not readable by uid $(id -u)"
		fi
	fi
}

make_workdir() {
	WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX") || die "$EX_CONFIG" "cannot create a temporary directory"
	if [[ ! $WORKDIR =~ ^/[A-Za-z0-9._/@+-]+$ ]]; then
		die "$EX_CONFIG" "temporary directory path $WORKDIR has unsafe characters; set TMPDIR"
	fi
}

# ---------------------------------------------------------------------------
# nginx: candidate test, full test, dump, reload
# ---------------------------------------------------------------------------

TEST_OUTPUT=

# Step 9: test the candidate alone in a throwaway configuration. Runs without
# the helper: nothing in it needs root.
candidate_test() { # file
	local file=$1 conf="$WORKDIR/nginx-test.conf" v mod rc=0
	mkdir -p -- "$WORKDIR/nginx"
	v=$("$NGINX_BIN" -V 2>&1 || true)
	{
		printf '# Throwaway configuration for the candidate syntax test.\n'
		printf 'pid "%s/nginx/nginx.pid";\n' "$WORKDIR"
		printf 'error_log "%s/nginx/error.log";\n' "$WORKDIR"
		printf 'events {\n    worker_connections 16;\n}\n'
		printf 'http {\n'
		printf '    access_log off;\n'
		printf '    client_body_temp_path "%s/nginx/client_body";\n' "$WORKDIR"
		for mod in proxy fastcgi uwsgi scgi; do
			if [[ $v != *"--without-http_${mod}_module"* ]]; then
				printf '    %s_temp_path "%s/nginx/%s";\n' "$mod" "$WORKDIR" "$mod"
			fi
		done
		printf '    include "%s";\n' "$file"
		printf '}\n'
	} >"$conf"
	TEST_OUTPUT=$("$NGINX_BIN" -t -q -p "$WORKDIR/nginx/" -c "$conf" 2>&1) || rc=$?
	return "$rc"
}

full_test() {
	local rc=0
	TEST_OUTPUT=$(run_priv "${TEST_CMD[@]}" 2>&1) || rc=$?
	return "$rc"
}

first_error() {
	local line
	line=$(printf '%s\n' "$TEST_OUTPUT" | grep -E 'emerg|error|failed' | head -n 1 || true)
	if [[ -z $line ]]; then
		line=$(printf '%s\n' "$TEST_OUTPUT" | head -n 1)
	fi
	quote_line "${line:-no output}"
}

nginx_running() {
	local pid
	if [[ $SERVICE_MANAGER == systemd ]]; then
		systemctl is-active --quiet "${CFG[CFRN_SERVICE_NAME]}"
		return
	fi
	if [[ -r ${CFG[CFRN_PID_FILE]} ]]; then
		pid=$(head -n 1 -- "${CFG[CFRN_PID_FILE]}" 2>/dev/null || true)
		[[ $pid =~ ^[0-9]+$ && -d /proc/$pid ]]
		return
	fi
	return 1
}

RELOAD_NOTE=

# Returns 0 reloaded, 1 failed, 2 nginx not running.
do_reload() {
	local out rc=0
	if ! nginx_running; then
		RELOAD_NOTE="nginx is not running, reload skipped (it reads the snippet when it starts)"
		STATE[pending_reload]=0
		return 2
	fi
	out=$(run_priv "${RELOAD_CMD[@]}" 2>&1) || rc=$?
	if ((rc != 0)); then
		RELOAD_NOTE="reload failed (${RELOAD_CMD[*]}, exit $rc): $(quote_line "$(printf '%s\n' "$out" | head -n 1)")"
		STATE[pending_reload]=1
		return 1
	fi
	RELOAD_NOTE="nginx reloaded"
	STATE[pending_reload]=0
	return 0
}

check_included() { # first_run
	local dump rc=0
	dump=$(run_priv "${DUMP_CMD[@]}" 2>/dev/null) || rc=$?
	if ((rc != 0)); then
		warn "could not run '${DUMP_CMD[*]}' to check that $OUTPUT is included"
		return 0
	fi
	if ! grep -qF -- "$OUTPUT" <<<"$dump"; then
		warn "$OUTPUT is not included anywhere in the nginx configuration, so it has no effect until it is"
		if [[ $1 == 1 ]]; then
			warn "add this line once inside the http { } block of nginx.conf: include $OUTPUT;"
		fi
	fi
}

# ---------------------------------------------------------------------------
# Installing files
# ---------------------------------------------------------------------------

STAGED=

# Put the content of $1 in a staging file ready to become the live snippet.
stage_file() { # source
	if [[ $IS_ROOT == 1 ]]; then
		STAGED=$(mktemp "$STAGING_DIR/.cloudflare-realip.XXXXXX") || die "$EX_CONFIG" "cannot create a temporary file in $STAGING_DIR"
		CLEANUP_FILES+=("$STAGED")
	else
		STAGED="$STATE_DIR/staged.conf"
		CLEANUP_FILES+=("$STAGED")
	fi
	if ! cp -- "$1" "$STAGED" 2>/dev/null || ! cmp -s -- "$1" "$STAGED"; then
		rm -f -- "$STAGED" || true
		die "$EX_CONFIG" "cannot write $STAGED (disk full or read-only?)"
	fi
	chmod 0644 -- "$STAGED"
}

# Move the staged file over the live snippet.
promote_staged() {
	if [[ $IS_ROOT == 1 ]]; then
		mv -f -- "$STAGED" "$OUTPUT"
	else
		run_priv install -m 0644 "$STAGED" "$OUTPUT"
		rm -f -- "$STAGED"
	fi
}

# Put the backup (or nothing, on a first run) back at the live path.
restore_previous() { # had_backup
	local placeholder
	if [[ $1 == 1 && -f "$STATE_DIR/previous.conf" ]]; then
		stage_file "$STATE_DIR/previous.conf"
		promote_staged
	elif [[ $IS_ROOT == 1 ]]; then
		rm -f -- "$OUTPUT"
	else
		# Without root there is no delete in the allowed command set, so the
		# file is replaced by a header-only snippet that trusts nothing.
		placeholder="$WORKDIR/placeholder.conf"
		printf '%s\n# Placeholder after a failed first run: trusts nothing.\n' "$MARKER" >"$placeholder"
		stage_file "$placeholder"
		promote_staged
	fi
}

save_backup() {
	local tmp
	tmp=$(mktemp "$STATE_DIR/.previous.XXXXXX")
	CLEANUP_FILES+=("$tmp")
	cp -- "$OUTPUT" "$tmp"
	chmod 0644 -- "$tmp"
	mv -f -- "$tmp" "$STATE_DIR/previous.conf"
}

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------

fetch_and_render() { # sets CANDIDATE
	load_reserved
	fetch_list "$URL_V4" "$WORKDIR/v4.txt"
	fetch_list "$URL_V6" "$WORKDIR/v6.txt"
	load_list 4 "$WORKDIR/v4.txt" "$URL_V4"
	load_list 6 "$WORKDIR/v6.txt" "$URL_V6"
	CANDIDATE="$WORKDIR/candidate.conf"
	render >"$CANDIDATE"
}

CANDIDATE=

log_changes() {
	local v
	for v in "${ADDED[@]+"${ADDED[@]}"}"; do
		info "added: $v"
	done
	for v in "${REMOVED[@]+"${REMOVED[@]}"}"; do
		info "removed: $v"
	done
}

warn_if_stale() {
	local last=${STATE[last_success]:-} limit=$((CFG[CFRN_STALE_DAYS] * 86400))
	if [[ -n $last && $last =~ ^[0-9]+$ ]] && ((NOW - last > limit)); then
		warn "last success was $(((NOW - last) / 86400)) days ago (limit ${CFG[CFRN_STALE_DAYS]} days)"
	fi
}

# W14: a previous run stopped between the rename and the full test.
recover_interrupted() {
	if [[ ${STATE[in_progress]:-0} != 1 ]]; then
		return 0
	fi
	warn "the previous run was interrupted after installing a new snippet; testing it now"
	if full_test; then
		info "interrupted snippet passes nginx -t; keeping it"
		STATE[pending_reload]=1
	else
		warn "interrupted snippet fails nginx -t: $(first_error); restoring the backup"
		restore_previous "${STATE[in_progress_had_backup]:-0}"
		if ! full_test; then
			warn "nginx -t still fails after the restore: the configuration is broken outside this snippet"
		fi
	fi
	STATE[in_progress]=0
	STATE[in_progress_had_backup]=0
	state_save
}

mode_update() {
	local first_run=0 had_backup=0 rc
	NOW=$(date +%s)
	ensure_state_dir
	take_lock
	RECORD_RUN=1
	state_load
	preflight
	make_workdir
	recover_interrupted

	local hold=${STATE[hold_until]:-0}
	if [[ $hold =~ ^[0-9]+$ ]] && ((hold > 0)); then
		if ((NOW < hold)); then
			RUN_RESULT=held
			info "held after rollback until $(date -u -d "@$hold" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '%s' "$hold"); run --release to resume updates"
			exit "$EX_OK"
		fi
		warn "rollback hold expired; resuming updates"
		STATE[hold_until]=0
	fi
	warn_if_stale

	if [[ -f $OUTPUT ]]; then
		if ! is_ours "$OUTPUT"; then
			if [[ $FORCE == 1 ]]; then
				warn "$OUTPUT was not written by this tool; replacing it because of --force (a copy goes to the backup)"
			else
				die "$EX_CONFIG" "$OUTPUT was not written by this tool; refusing to overwrite it (use --force to replace it, the old file is kept as the backup)"
			fi
		fi
	else
		first_run=1
	fi

	fetch_and_render
	if [[ $first_run == 0 ]]; then
		read_previous "$OUTPUT"
		shrink_guard
	fi
	compute_changes

	local counts="${#LIST_V4[@]} IPv4, ${#LIST_V6[@]} IPv6"
	STATE[count_v4]=${#LIST_V4[@]}
	STATE[count_v6]=${#LIST_V6[@]}

	# W1: nothing changed.
	if [[ $first_run == 0 ]] && cmp -s -- "$CANDIDATE" "$OUTPUT"; then
		STATE[snippet_sha256]=$(sha256_of "$OUTPUT")
		if [[ ${STATE[pending_reload]:-0} == 1 ]]; then
			rc=0
			do_reload || rc=$?
			if ((rc == 1)); then
				RUN_RESULT=reload-failed
				die "$EX_RELOAD" "$RELOAD_NOTE"
			fi
			RUN_RESULT=unchanged
			RUN_SUCCESS=1
			notice "unchanged: $counts, pending reload done ($RELOAD_NOTE)"
			exit "$EX_OK"
		fi
		RUN_RESULT=unchanged
		RUN_SUCCESS=1
		info "unchanged: $counts"
		exit "$EX_OK"
	fi

	# Step 8: stage the candidate.
	stage_file "$CANDIDATE"

	# Step 9: syntax test of the candidate alone.
	if ! candidate_test "$STAGED"; then
		rm -f -- "$STAGED"
		RUN_RESULT=candidate-test-failed
		if [[ $TEST_OUTPUT == *'unknown directive "set_real_ip_from"'* || $TEST_OUTPUT == *'unknown directive "real_ip_header"'* ]]; then
			die "$EX_TEST" "candidate test failed: nginx was built without ngx_http_realip_module: $(first_error)"
		fi
		die "$EX_TEST" "candidate test failed: $(first_error)"
	fi

	# Step 10: back up the live snippet.
	if [[ -f $OUTPUT ]]; then
		had_backup=1
	fi
	STATE[in_progress]=1
	STATE[in_progress_had_backup]=$had_backup
	state_save
	if [[ $had_backup == 1 ]]; then
		save_backup
	fi

	# Step 11: atomic rename into place.
	promote_staged

	# Step 12: full test.
	if ! full_test; then
		local why
		why=$(first_error)
		restore_previous "$had_backup"
		STATE[in_progress]=0
		STATE[in_progress_had_backup]=0
		RUN_RESULT=full-test-failed
		if full_test; then
			die "$EX_TEST" "nginx -t failed with the new snippet, previous state restored: $why"
		fi
		die "$EX_TEST" "nginx -t failed with the new snippet and still fails after restoring the previous state, so the configuration was already broken before this run: $why"
	fi
	STATE[in_progress]=0
	STATE[in_progress_had_backup]=0
	STATE[pending_reload]=1
	STATE[snippet_sha256]=$(sha256_of "$OUTPUT")
	state_save

	log_changes
	check_included "$first_run"

	# Step 13: reload.
	rc=0
	do_reload || rc=$?
	local summary="updated: $counts (+${#ADDED[@]} -${#REMOVED[@]})"
	if ((rc == 1)); then
		RUN_RESULT=reload-failed
		die "$EX_RELOAD" "$summary, but $RELOAD_NOTE; the new snippet stays and the next run retries the reload"
	fi
	RUN_RESULT=updated
	RUN_SUCCESS=1
	notice "$summary, $RELOAD_NOTE"
	exit "$EX_OK"
}

mode_preview() { # dry-run or diff
	local rc=0
	INFO_TO_STDERR=1
	NOW=$(date +%s)
	if [[ -e $OUTPUT && ! -r $OUTPUT ]]; then
		die "$EX_CONFIG" "$OUTPUT is not readable by uid $(id -u)"
	fi
	if [[ $WITH_TEST == 1 ]] && ! command -v "$NGINX_BIN" >/dev/null 2>&1; then
		die "$EX_CONFIG" "nginx binary '$NGINX_BIN' not found (set CFRN_NGINX)"
	fi
	make_workdir
	fetch_and_render
	PREV_ALL=()
	if [[ -f $OUTPUT ]]; then
		read_previous "$OUTPUT"
	fi
	compute_changes
	if [[ $MODE == dry-run ]]; then
		cat -- "$CANDIDATE"
		if [[ $WITH_TEST == 1 ]]; then
			if ! candidate_test "$CANDIDATE"; then
				if [[ $TEST_OUTPUT == *'unknown directive "set_real_ip_from"'* ]]; then
					die "$EX_TEST" "candidate test failed: nginx was built without ngx_http_realip_module: $(first_error)"
				fi
				die "$EX_TEST" "candidate test failed: $(first_error)"
			fi
			info "candidate test passed"
		fi
		info "dry run: ${#LIST_V4[@]} IPv4, ${#LIST_V6[@]} IPv6 (+${#ADDED[@]} -${#REMOVED[@]}), nothing changed"
		exit "$EX_OK"
	fi
	local live=/dev/null
	if [[ -f $OUTPUT ]]; then
		live=$OUTPUT
	fi
	diff -u -L "$OUTPUT (live)" -L "$OUTPUT (candidate)" -- "$live" "$CANDIDATE" || rc=$?
	if ((rc == 0)); then
		info "no difference: ${#LIST_V4[@]} IPv4, ${#LIST_V6[@]} IPv6"
		exit "$EX_OK"
	fi
	if ((rc != 1)); then
		die "$EX_CONFIG" "diff failed (exit $rc)"
	fi
	info "differences found: +${#ADDED[@]} -${#REMOVED[@]}"
	exit "$EX_DIFF"
}

mode_rollback() {
	local backup="$STATE_DIR/previous.conf" rc
	NOW=$(date +%s)
	if [[ ! -f $backup ]]; then
		die "$EX_CONFIG" "no backup at $backup; nothing to roll back to"
	fi
	ensure_state_dir
	take_lock
	RECORD_RUN=1
	state_load
	preflight
	make_workdir
	recover_interrupted

	local had_live=0 swap="$WORKDIR/swap.conf"
	if [[ -f $OUTPUT ]]; then
		had_live=1
		cp -- "$OUTPUT" "$swap"
	fi
	STATE[in_progress]=1
	STATE[in_progress_had_backup]=1
	state_save
	stage_file "$backup"
	promote_staged
	if [[ $had_live == 1 ]]; then
		cp -- "$swap" "$WORKDIR/newbackup.conf"
		local tmp
		tmp=$(mktemp "$STATE_DIR/.previous.XXXXXX")
		CLEANUP_FILES+=("$tmp")
		cp -- "$swap" "$tmp"
		chmod 0644 -- "$tmp"
		mv -f -- "$tmp" "$backup"
	else
		rm -f -- "$backup"
	fi

	if ! full_test; then
		local why
		why=$(first_error)
		# Swap back: the old live file is now the backup.
		if [[ $had_live == 1 ]]; then
			local orig="$WORKDIR/orig-backup.conf"
			cp -- "$OUTPUT" "$orig"
			stage_file "$swap"
			promote_staged
			tmp=$(mktemp "$STATE_DIR/.previous.XXXXXX")
			CLEANUP_FILES+=("$tmp")
			cp -- "$orig" "$tmp"
			chmod 0644 -- "$tmp"
			mv -f -- "$tmp" "$backup"
		else
			cp -- "$OUTPUT" "$backup"
			restore_previous 0
		fi
		STATE[in_progress]=0
		STATE[in_progress_had_backup]=0
		RUN_RESULT=rollback-test-failed
		die "$EX_TEST" "rollback failed nginx -t, swapped back: $why"
	fi
	STATE[in_progress]=0
	STATE[in_progress_had_backup]=0
	STATE[pending_reload]=1
	STATE[snippet_sha256]=$(sha256_of "$OUTPUT")
	STATE[hold_until]=$((NOW + CFG[CFRN_HOLD_DAYS] * 86400))
	state_save
	rc=0
	do_reload || rc=$?
	if ((rc == 1)); then
		RUN_RESULT=reload-failed
		die "$EX_RELOAD" "rolled back, but $RELOAD_NOTE"
	fi
	RUN_RESULT=rolled-back
	notice "rolled back to the previous snippet, $RELOAD_NOTE; scheduled runs are held for ${CFG[CFRN_HOLD_DAYS]} days or until --release"
	exit "$EX_OK"
}

mode_release() {
	ensure_state_dir
	take_lock
	state_load
	if [[ ${STATE[hold_until]:-0} == 0 ]]; then
		info "no hold is set"
		exit "$EX_OK"
	fi
	STATE[hold_until]=0
	state_save
	notice "hold released; the next run updates normally"
	exit "$EX_OK"
}

fmt_time() {
	if [[ -n ${1:-} && $1 =~ ^[0-9]+$ && $1 != 0 ]]; then
		date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '%s' "$1"
	else
		printf 'never'
	fi
}

mode_status() {
	NOW=$(date +%s)
	state_load
	local hold=${STATE[hold_until]:-0}
	printf 'snippet:        %s\n' "$OUTPUT"
	printf 'snippet sha256: %s\n' "$(sha256_of "$OUTPUT")"
	printf 'last run:       %s (%s, exit %s)\n' "$(fmt_time "${STATE[last_run]:-}")" "${STATE[last_result]:-none}" "${STATE[last_exit]:-none}"
	printf 'last success:   %s\n' "$(fmt_time "${STATE[last_success]:-}")"
	printf 'ranges:         %s IPv4, %s IPv6\n' "${STATE[count_v4]:-0}" "${STATE[count_v6]:-0}"
	printf 'pending reload: %s\n' "$([[ ${STATE[pending_reload]:-0} == 1 ]] && printf yes || printf no)"
	if [[ $hold =~ ^[0-9]+$ ]] && ((hold > NOW)); then
		printf 'hold:           until %s (run --release to clear)\n' "$(fmt_time "$hold")"
	else
		printf 'hold:           none\n'
	fi
	local last=${STATE[last_success]:-}
	if [[ -z $last ]]; then
		warn "no successful run recorded yet"
	else
		warn_if_stale
	fi
	exit "$EX_OK"
}

mode_verify() {
	local failed=0 last
	NOW=$(date +%s)
	state_load
	check() { # ok? message
		if [[ $1 == 0 ]]; then
			printf 'ok:   %s\n' "$2"
		else
			printf 'FAIL: %s\n' "$2"
			failed=1
		fi
	}
	if [[ -f $OUTPUT ]]; then
		check 0 "snippet exists at $OUTPUT"
	else
		check 1 "snippet exists at $OUTPUT"
	fi
	if [[ -f $OUTPUT ]] && is_ours "$OUTPUT"; then
		check 0 "snippet was written by $PROG"
	else
		check 1 "snippet was written by $PROG"
	fi
	if [[ $IS_ROOT == 0 && ${#HELPER[@]} -eq 0 ]]; then
		check 1 "nginx -T and nginx -t need root or CFRN_PRIV_HELPER"
	else
		local dump rc=0
		dump=$(run_priv "${DUMP_CMD[@]}" 2>/dev/null) || rc=$?
		if ((rc == 0)) && grep -qF -- "$OUTPUT" <<<"$dump"; then
			check 0 "snippet is included in the nginx configuration"
		else
			check 1 "snippet is included in the nginx configuration"
		fi
		if full_test; then
			check 0 "nginx -t passes"
		else
			check 1 "nginx -t passes ($(first_error))"
		fi
	fi
	last=${STATE[last_success]:-}
	if [[ $last =~ ^[0-9]+$ ]] && ((NOW - last <= CFG[CFRN_STALE_DAYS] * 86400)); then
		check 0 "last success within ${CFG[CFRN_STALE_DAYS]} days ($(fmt_time "$last"))"
	else
		check 1 "last success within ${CFG[CFRN_STALE_DAYS]} days ($(fmt_time "$last"))"
	fi
	if ((failed)); then
		exit "$EX_CONFIG"
	fi
	exit "$EX_OK"
}

main() {
	parse_args "$@"
	case $MODE in
	help)
		usage
		exit "$EX_OK"
		;;
	version)
		printf '%s %s\n' "$PROG" "$VERSION"
		exit "$EX_OK"
		;;
	esac
	load_settings
	case $MODE in
	update) mode_update ;;
	dry-run | diff) mode_preview ;;
	rollback) mode_rollback ;;
	release) mode_release ;;
	status) mode_status ;;
	verify) mode_verify ;;
	esac
}

main "$@"
